{% extends 'base.html.twig' %}

{% block title %}Hello World!{% endblock %}

{% block body %}
    <div class="container" style="text-align: center; margin-top: 50px;">
        <h1>Hi Alyssa</h1>

        <div data-controller="hello">
            <button data-action="click->hello#greet" class="btn">Click Me!</button>
            <p data-hello-target="output" style="font-size: 1.5rem; margin-top: 20px;"></p>
        </div>
    </div>
{% endblock %}
