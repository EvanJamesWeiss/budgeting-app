{% extends 'base.html.twig' %}

{% block title %}Recurring Payments{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div style="background-color: #e8f5e9; border: 1px solid #a5d6a7; color: #2e7d32; padding: 12px 16px; border-radius: 4px; margin-bottom: 16px;">
            {{ message }}
        </div>
    {% endfor %}

    <div class="card">
        <h2>Recurring Payments</h2>
        <p style="color: var(--text-secondary);">Manage recurring payment definitions that are automatically added to each month's ledger.</p>
    </div>

    <div class="card">
        <h3 style="margin-top: 0;">Add New Recurring Payment</h3>
        {% include 'recurring_payment/_form.html.twig' with {'form': createForm, 'submitLabel': 'Create'} %}
    </div>

    <div class="card">
        <h3 style="margin-top: 0;">Active Recurring Payments</h3>

        {% if templates is empty %}
            <p style="color: var(--text-secondary); text-align: center; padding: 24px 0;">
                No recurring payments defined yet. Add one above to get started.
            </p>
        {% else %}
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid var(--border-color); text-align: left;">
                        <th style="padding: 12px;">Title</th>
                        <th style="padding: 12px;">Default Amount</th>
                        <th style="padding: 12px;">Paid By</th>
                        <th style="padding: 12px;">Split Ratio</th>
                        <th style="padding: 12px;">Payment Type</th>
                        <th style="padding: 12px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for template in templates %}
                        {% set isEditing = (activeEditId is defined and activeEditId == template.id) %}
                        {# Display row #}
                        <tr id="row-{{ template.id }}" style="border-bottom: 1px solid var(--border-color);" {% if isEditing %}class="editing-row"{% endif %}>
                            <td style="padding: 12px;">{{ template.title }}</td>
                            <td style="padding: 12px;">
                                {% if template.defaultAmount is not null %}
                                    ${{ template.defaultAmount|number_format(2) }}
                                {% else %}
                                    <span style="color: var(--text-secondary);">—</span>
                                {% endif %}
                            </td>
                            <td style="padding: 12px;">{{ template.paidBy.name }}</td>
                            <td style="padding: 12px;">
                                {% set ratio = template.defaultSplitRatio %}
                                {{ template.paidBy.name }} {{ (ratio * 100)|number_format(0) }}% – {{ (100 - ratio * 100)|number_format(0) }}%
                            </td>
                            <td style="padding: 12px;">
                                {% if template.isStatic %}
                                    <span style="color: #1976d2; font-weight: 500;">Fixed</span>
                                {% else %}
                                    <span style="color: #f57c00; font-weight: 500;">Variable</span>
                                {% endif %}
                            </td>
                            <td style="padding: 12px;">
                                <button
                                    type="button"
                                    onclick="toggleEditRow({{ template.id }})"
                                    class="mdc-button mdc-button--raised"
                                    style="height: 30px; font-size: 12px; margin-right: 8px;"
                                >Edit</button>
                                <form action="{{ path('app_recurring_payments_delete', {id: template.id}) }}" method="post" style="display: inline;">
                                    <button
                                        type="submit"
                                        class="mdc-button"
                                        style="height: 30px; font-size: 12px; background-color: #dc004e; color: white;"
                                        onclick="return confirm('Are you sure you want to delete this recurring payment?');"
                                    >Delete</button>
                                </form>
                            </td>
                        </tr>
                        {# Inline edit row #}
                        <tr id="edit-row-{{ template.id }}" style="display: {% if isEditing %}table-row{% else %}none{% endif %}; background-color: var(--surface-color);">
                            <td colspan="6" style="padding: 16px; border-bottom: 1px solid var(--border-color); border-top: 1px solid var(--border-color);">
                                {% include 'recurring_payment/_form.html.twig' with {'form': editForms[template.id], 'submitLabel': 'Save Changes'} %}
                                <button
                                    type="button"
                                    onclick="toggleEditRow({{ template.id }})"
                                    style="margin-top: 8px; background: none; border: none; cursor: pointer; color: var(--text-secondary); font-size: 13px; text-decoration: underline;"
                                >Cancel</button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>

    <script>
        function toggleEditRow(id) {
            var editRow = document.getElementById('edit-row-' + id);
            if (editRow.style.display === 'none' || editRow.style.display === '') {
                editRow.style.display = 'table-row';
            } else {
                editRow.style.display = 'none';
            }
        }

        {% if activeEditId is defined %}
            // Auto-open the edit row that had a validation error
            document.getElementById('edit-row-{{ activeEditId }}')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        {% endif %}
    </script>
{% endblock %}
