{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

<div style="display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px;">
    <div style="flex: 2; min-width: 200px;">
        <label style="display: block; margin-bottom: 8px;">Title</label>
        {{ form_widget(form.title, {'attr': {'style': 'width: 100%; padding: 8px; border: 1px solid var(--border-color); border-radius: 4px; background-color: var(--input-bg); color: var(--text-primary);', 'placeholder': 'e.g. Rent'}}) }}
        {% if form.title.vars.errors|length > 0 %}
            <ul style="color: red; margin: 4px 0 0; padding: 0; list-style: none; font-size: 12px;">
                {% for error in form.title.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <div style="flex: 1; min-width: 140px;">
        <label style="display: block; margin-bottom: 8px;">Payment Type</label>
        {{ form_widget(form.isStatic, {'attr': {'style': 'width: 100%; padding: 8px; border: 1px solid var(--border-color); border-radius: 4px; background-color: var(--input-bg); color: var(--text-primary);'}}) }}
        {% if form.isStatic.vars.errors|length > 0 %}
            <ul style="color: red; margin: 4px 0 0; padding: 0; list-style: none; font-size: 12px;">
                {% for error in form.isStatic.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <div style="flex: 1; min-width: 140px;">
        <label style="display: block; margin-bottom: 8px;">Default Amount ($)</label>
        {{ form_widget(form.defaultAmount, {'attr': {'style': 'width: 100%; padding: 8px; border: 1px solid var(--border-color); border-radius: 4px; background-color: var(--input-bg); color: var(--text-primary);', 'step': '0.01', 'min': '0', 'placeholder': '0.00'}}) }}
        {% if form.defaultAmount.vars.errors|length > 0 %}
            <ul style="color: red; margin: 4px 0 0; padding: 0; list-style: none; font-size: 12px;">
                {% for error in form.defaultAmount.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <div style="flex: 1; min-width: 140px;">
        <label style="display: block; margin-bottom: 8px;">Paid By</label>
        {{ form_widget(form.paidBy, {'attr': {'style': 'width: 100%; padding: 8px; border: 1px solid var(--border-color); border-radius: 4px; background-color: var(--input-bg); color: var(--text-primary);'}}) }}
        {% if form.paidBy.vars.errors|length > 0 %}
            <ul style="color: red; margin: 4px 0 0; padding: 0; list-style: none; font-size: 12px;">
                {% for error in form.paidBy.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <div style="flex: 1; min-width: 140px;">
        <label style="display: block; margin-bottom: 8px;">Split Ratio (0.00–1.00)</label>
        {{ form_widget(form.defaultSplitRatio, {'attr': {'style': 'width: 100%; padding: 8px; border: 1px solid var(--border-color); border-radius: 4px; background-color: var(--input-bg); color: var(--text-primary);', 'step': '0.01', 'min': '0', 'max': '1', 'placeholder': '0.75'}}) }}
        {% if form.defaultSplitRatio.vars.errors|length > 0 %}
            <ul style="color: red; margin: 4px 0 0; padding: 0; list-style: none; font-size: 12px;">
                {% for error in form.defaultSplitRatio.vars.errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>

<button type="submit" class="mdc-button mdc-button--raised">{{ submitLabel|default('Save') }}</button>

{{ form_end(form) }}
