{% extends 'base.html.twig' %}

{% block title %}All-Time Balance{% endblock %}

{% block body %}
    <div class="card">
        <h2>Unsettled Months</h2>
        {% if summaries|length > 0 %}
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 2px solid #eee; text-align: left;">
                        <th style="padding: 12px;">Month</th>
                        <th style="padding: 12px;">Status</th>
                        <th style="padding: 12px;">Amount</th>
                        <th style="padding: 12px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    {% for summary in summaries %}
                        <tr style="border-bottom: 1px solid #eee;">
                            <td style="padding: 12px;">{{ summary.monthYear }}</td>
                            <td style="padding: 12px;">
                                {{ summary.debtorName }} owes {{ summary.creditorName }}
                            </td>
                            <td style="padding: 12px; font-weight: bold; color: var(--mdc-theme-secondary);">
                                ${{ summary.netOwedAmount|number_format(2) }}
                            </td>
                            <td style="padding: 12px;">
                                <a href="{{ path('app_ledger', {monthYear: summary.monthYear}) }}" class="mdc-button mdc-button--raised" style="text-decoration: none; font-size: 12px; height: 28px;">View Ledger</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p style="color: green; font-weight: bold;">Everything is settled! Good job!</p>
        {% endif %}
    </div>

    <div class="card">
        <h2>Total Debt Summary</h2>
        {% set totalUser1_owes = 0 %}
        {% set totalUser2_owes = 0 %}
        {% set user1Name = 'User 1' %}
        {% set user2Name = 'User 2' %}
        {% for summary in summaries %}
            {% if loop.first %}
                {% set user1Name = summary.user1Name %}
                {% set user2Name = summary.user2Name %}
            {% endif %}
            {% if summary.debtorId == 1 %}
                {% set totalUser1_owes = totalUser1_owes + summary.netOwedAmount %}
            {% else %}
                {% set totalUser2_owes = totalUser2_owes + summary.netOwedAmount %}
            {% endif %}
        {% endfor %}

        <div style="display: flex; gap: 40px;">
            <div>
                <h3>{{ user1Name }} Total Owed:</h3>
                <h2 style="color: {% if totalUser1_owes > 0 %}var(--mdc-theme-secondary){% else %}green{% endif %}">${{ totalUser1_owes|number_format(2) }}</h2>
            </div>
            <div>
                <h3>{{ user2Name }} Total Owed:</h3>
                <h2 style="color: {% if totalUser2_owes > 0 %}var(--mdc-theme-secondary){% else %}green{% endif %}">${{ totalUser2_owes|number_format(2) }}</h2>
            </div>
        </div>
    </div>
{% endblock %}
